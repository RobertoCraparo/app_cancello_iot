<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView android:id="@+id/tvGpio"
        android:layout_width="70dp"
        android:layout_height="28dp"
        android:gravity="center"
        android:textSize="11sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:textColor="@color/gray_700"
        android:background="@color/gray_100"/>

    <TextView android:id="@+id/tvModulo"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textSize="13sp"
        android:textColor="@color/gray_700"
        android:paddingStart="12dp"/>

    <TextView android:id="@+id/tvBus"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="11sp" android:textStyle="bold"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:paddingTop="3dp" android:paddingBottom="3dp"
        android:background="@drawable/bg_status_ok"/>
</LinearLayout>
